{
  "name": "@product-repos/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./brands": {
      "types": "./src/brands.ts",
      "import": "./src/brands.ts"
    },
    "./unit-types": {
      "types": "./src/unit-types.ts",
      "import": "./src/unit-types.ts"
    },
    "./products": {
      "types": "./src/products.ts",
      "import": "./src/products.ts"
    },
    "./product-search": {
      "types": "./src/product-search.ts",
      "import": "./src/product-search.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
