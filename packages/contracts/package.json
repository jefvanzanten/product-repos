{
  "name": "@product-repos/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./brands": {
      "types": "./src/brands.ts",
      "import": "./src/brands.ts",
      "default": "./src/brands.ts"
    },
    "./unit-types": {
      "types": "./src/unit-types.ts",
      "import": "./src/unit-types.ts",
      "default": "./src/unit-types.ts"
    },
    "./categories": {
      "types": "./src/categories.ts",
      "import": "./src/categories.ts",
      "default": "./src/categories.ts"
    },
    "./package-types": {
      "types": "./src/package-types.ts",
      "import": "./src/package-types.ts",
      "default": "./src/package-types.ts"
    },
    "./products": {
      "types": "./src/products.ts",
      "import": "./src/products.ts",
      "default": "./src/products.ts"
    },
    "./concrete-products": {
      "types": "./src/concrete-products.ts",
      "import": "./src/concrete-products.ts",
      "default": "./src/concrete-products.ts"
    },
    "./recipes": {
      "types": "./src/recipes.ts",
      "import": "./src/recipes.ts",
      "default": "./src/recipes.ts"
    },
    "./calorie-tracker": {
      "types": "./src/calorie-tracker.ts",
      "import": "./src/calorie-tracker.ts",
      "default": "./src/calorie-tracker.ts"
    },
    "./inventory": {
      "types": "./src/inventory.ts",
      "import": "./src/inventory.ts",
      "default": "./src/inventory.ts"
    },
    "./locations": {
      "types": "./src/locations.ts",
      "import": "./src/locations.ts",
      "default": "./src/locations.ts"
    }
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "zod": "^4.3.6"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
