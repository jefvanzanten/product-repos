{
  "name": "product-repos",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm --filter \"./apps/*\" --parallel run dev",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "backend:build": "pnpm --filter @product-repos/backend build",
    "backend:dev": "pnpm --filter @product-repos/backend dev",
    "backend:start": "pnpm --filter @product-repos/backend start",
    "backend:typecheck": "pnpm --filter @product-repos/backend typecheck",
    "db:generate": "pnpm --filter @product-repos/backend db:generate",
    "db:migrate": "pnpm --filter @product-repos/backend db:migrate",
    "db:push": "pnpm --filter @product-repos/backend db:push",
    "db:studio": "pnpm --filter @product-repos/backend db:studio",
    "db:seed": "pnpm --filter @product-repos/backend db:seed",
    "inventory:build": "pnpm --filter inventory build",
    "inventory:dev": "pnpm --filter inventory dev",
    "inventory:start": "pnpm --filter inventory start",
    "inventory:typecheck": "pnpm --filter inventory typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
