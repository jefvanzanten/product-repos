{
  "name": "@product-repos/backend",
  "version": "1.0.0",
  "description": "Backend API with Hono, Drizzle ORM and SQLite",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "bunx drizzle-kit push",
    "db:seed": "bun run src/db/seed.ts",
    "auth:seed-user": "bun run src/jobs/seed-auth-user.ts",
    "calorie-tracker:cleanup": "bun run src/jobs/cleanup-deleted-consumption-logs.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hono",
    "bun",
    "drizzle",
    "sqlite",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@product-repos/contracts": "workspace:*",
    "@product-repos/shared": "workspace:*",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "typescript": "^5.7.2"
  }
}
