# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=./db/sqlite.db

# CORS and authentication configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3001
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_DISABLE_SIGN_UP=true
# Set to a shared production parent domain, for example .example.com.
AUTH_COOKIE_DOMAIN=

# One-off account provisioning used by `auth:seed-user`.
AUTH_SEED_EMAIL=
AUTH_SEED_NAME=
AUTH_SEED_PASSWORD=
AUTH_SEED_ROLE=user
